# 本机真实邮件配置示例。复制为 scripts/dev-local.env 后填写；真实文件已被 git 忽略。
# Windows：Copy-Item scripts/dev-local.env.example scripts/dev-local.env
# macOS / Linux：cp scripts/dev-local.env.example scripts/dev-local.env
#
# 可从另一台电脑的 scripts/dev-local.env 复制以下值，不要把真实密码提交或发到聊天中。
# SMTP_PASS 对 QQ/163 等邮箱通常是 SMTP 授权码，不是邮箱登录密码。
# 端口沿用邮件服务商要求；465 自动启用 SSL，25/587 等端口保持非隐式 TLS 协商。
# SMTP_FROM 中的邮箱通常应与 SMTP_USER 一致，避免邮件服务商拒绝发信。
# 值统一用单引号包裹，防止 Bash 将授权码中的 $、反引号或反斜杠当作脚本展开。
# 如果实际值本身含单引号，需要额外转义，不能不加处理地直接放入单引号中。

SMTP_HOST='smtp.example.com'
SMTP_PORT='465'
SMTP_USER='your-email@example.com'
SMTP_PASS='replace-with-smtp-password-or-authorization-code'
SMTP_FROM='Gmind <your-email@example.com>'

# 填完后重启：
# Windows：powershell -ExecutionPolicy Bypass -File scripts/dev.ps1 restart
# macOS / Linux：scripts/dev-restart.sh
